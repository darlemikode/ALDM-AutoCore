{
  "expo": {
    "name": "ALDMAutoCore Cliente",
    "slug": "sistema-mecanico-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#070708"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tutaller.mecanicocliente"
    },
    "android": {
      "package": "com.tutaller.mecanicocliente",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070708"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://app.aldmautocore.com/api",
      "wsUrl": "wss://app.aldmautocore.com",
      "eas": {
        "projectId": "e84e647f-f306-41fe-9bfc-9f60145ca98d"
      }
    },
    "scheme": "aldmcliente",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el código QR de tu taller."
        }
      ]
    ]
  }
}
