{
  "expo": {
    "name": "Mi Taller",
    "slug": "sistema-mecanico-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#132a33"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tutaller.mecanicocliente"
    },
    "android": {
      "package": "com.tutaller.mecanicocliente",
      "adaptiveIcon": {
        "backgroundColor": "#132a33"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://aldm-autocore-app-abcxcugnfbgaaah0.centralus-01.azurewebsites.net/api",
      "wsUrl": "wss://aldm-autocore-app-abcxcugnfbgaaah0.centralus-01.azurewebsites.net"
    },
    "scheme": "aldmcliente",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el código QR de tu taller."
        }
      ]
    ]
  }
}
