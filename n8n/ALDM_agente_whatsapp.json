    {
      "parameters": {
        "jsCode": "// Solo mensajes de texto entrantes; ignora estados (entregado/leído) y otros tipos\nconst salida = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  const m = (v.messages || [])[0];\n  if (!m || m.type !== 'text') continue;\n  salida.push({ json: {\n    telefono: m.from,\n    texto: (m.text?.body || '').slice(0, 1500),\n    nombre_perfil: v.contacts?.[0]?.profile?.name || '',\n    phone_number_id: v.metadata?.phone_number_id,\n  }});\n}\nreturn salida;"
      },
