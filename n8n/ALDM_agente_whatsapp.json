    {
      "parameters": {
        "jsCode": "// Separa la etiqueta [[NOTA:n]] (si el agente decidió mandar el PDF) del texto\nconst salida = [];\nfor (const item of $input.all()) {\n  const texto = String(item.json.output || '').trim();\n  const m = texto.match(/\\[\\[NOTA:(\\d+)\\]\\]/);\n  salida.push({ json: {\n    texto: texto.replace(/\\[\\[NOTA:\\d+\\]\\]/g, '').trim().slice(0, 4000) || 'Con gusto le ayudo.',\n    id_orden: m ? Number(m[1]) : null,\n  }});\n}\nreturn salida;"
      },
