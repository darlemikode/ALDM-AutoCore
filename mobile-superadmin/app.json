{
  "expo": {
    "name": "ALDMAutoCoreSuper",
    "slug": "aldm-superadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#070708"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aldm.superadmin"
    },
    "android": {
      "package": "com.aldm.superadmin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070708"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://app.aldmautocore.com/api",
      "eas": {
        "projectId": "9d23ca15-050a-4a75-b5dd-c057c6cb752c"
      }
    },
    "plugins": [
      "expo-notifications"
    ]
  }
}