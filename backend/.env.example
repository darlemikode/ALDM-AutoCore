# Copia este archivo a ".env" y ajusta los valores

# Por defecto: SQLite, un solo archivo, sin instalar ni levantar ningún
# servidor de base de datos (bueno para probar el sistema o usarlo un solo
# usuario a la vez).
DATABASE_URL=sqlite:///./sistema_mecanico.db

# --- Opción PostgreSQL --- (requiere Postgres corriendo y
# `pip install -r requirements-postgres.txt`)
# DATABASE_URL=postgresql+psycopg2://mecanico_user:mecanico_pass@localhost:5432/sistema_mecanico

# --- Opción SQL Server --- (si ya lo tienes instalado en tu máquina;
# requiere `pip install -r requirements-mssql.txt` y el "ODBC Driver for
# SQL Server" de Microsoft — ver ese archivo). Antes de arrancar, crea la
# base vacía "sistema_mecanico" en SQL Server (con SSMS o Azure Data Studio).
#
# Con autenticación de Windows (la más común si es tu propia máquina):
# DATABASE_URL=mssql+pyodbc://@localhost/sistema_mecanico?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
#
# Con usuario y contraseña de SQL Server:
# DATABASE_URL=mssql+pyodbc://usuario:contraseña@localhost/sistema_mecanico?driver=ODBC+Driver+17+for+SQL+Server
#
# Si tu instalación es "named instance" (ej. SQLEXPRESS), el servidor se
# escribe así: localhost\SQLEXPRESS (revisa el nombre exacto en SSMS).

SECRET_KEY=cambia-esta-clave-por-una-generada-con-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario administrador que se crea automáticamente la primera vez (seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Multi-taller: este usuario también es el SÚPER ADMINISTRADOR (entra a la
# app "ALDM Súper Admin") y Administrador General del taller principal.

# Dirección pública del servidor (ej. https://api.midominio.com). Si se
# llena, el QR de cada taller abre una página web que lleva a la app de
# clientes; si se deja vacía, el QR abre directo la app (aldmcliente://).
URL_PUBLICA=

# Opcional: correo del admin sembrado, para recibir avisos si configuras SMTP más abajo
ADMIN_CORREO=

# Opcional: si configuras esto, el admin también recibe por correo el aviso
# de solicitudes de recuperación de contraseña (además de verlas en el panel).
# Si lo dejas vacío, el sistema sigue funcionando normal, solo sin ese correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Facturación electrónica (CFDI 4.0) ---
# Llave de Facturapi (https://dashboard.facturapi.io → API Keys).
# sk_test_... = pruebas (no llega al SAT) · sk_live_... = producción.
# Luego en el panel: Configuración → Facturación → Proveedor "Facturapi".
FACTURAPI_API_KEY=
