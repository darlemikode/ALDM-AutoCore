{
  "expo": {
    "name": "ALDM AutoCore",
    "slug": "sistema-mecanico-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#070708"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tutaller.mecanicoadmin",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para proteger el acceso a tu sesión del taller."
      }
    },
    "android": {
      "package": "com.tutaller.mecanicoadmin",
      "adaptiveIcon": {
        "backgroundColor": "#070708"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "ALDM AutoCore",
      "shortName": "ALDM AutoCore",
      "themeColor": "#070708",
      "backgroundColor": "#070708",
      "display": "standalone",
      "orientation": "portrait"
    },
    "extra": {
      "apiUrl": "https://app.aldmautocore.com/api",
      "wsUrl": "wss://app.aldmautocore.com",
      "eas": {
        "projectId": "cde216c9-9704-48ca-8b6d-5edac3a28dd6"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
